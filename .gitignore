# This is a monorepo: frontend/ (Flutter app, own .gitignore) and backend/
# (Node API, own .gitignore) each ignore their own build artifacts. This
# root .gitignore only covers editor/OS clutter that could land at the repo
# root itself.

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

.DS_Store
*.log
*.swp
