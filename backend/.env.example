# Copy this file to .env and adjust if needed. Defaults work out of the box
# with the local mongod instance already running on this machine.
MONGODB_URI=mongodb://127.0.0.1:27017/dodomed
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Comma-separated list of web origins allowed to call this API (CORS).
# Irrelevant for native apps (Android/iOS don't send an Origin header) — this
# only matters for the Flutter web build. Left unset/empty here for local
# development, where it accepts any origin; set it to your deployed app's
# real domain(s) before this is public, e.g.:
# CORS_ORIGIN=https://app.dodomed.et
CORS_ORIGIN=
